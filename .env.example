# --- Neon Postgres (base de datos en la nube) ---
DATABASE_URL=postgresql://usuario:password@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Desglosado docker-compose
PGHOST=ep-xxxx-xxxx.region.aws.neon.tech
PGPORT=5432
PGDATABASE=neondb
PGUSER=usuario
PGPASSWORD=password
PGSSLMODE=require

# --- Modelo de IA para el agente conversacional ---
GOOGLE_API_KEY=tu_api_key_aqui
# ANTHROPIC_API_KEY=tu_api_key_aqui
# OPENAI_API_KEY=tu_api_key_aqui
